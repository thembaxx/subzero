{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm fonts && next dev --hostname 0.0.0.0",
    "build": "pnpm fonts && next build",
    "start": "next start --hostname 0.0.0.0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "fonts": "node --use-env-proxy scripts/prepare-fonts.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.1",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "packageManager": "pnpm@11.25.0"
}
